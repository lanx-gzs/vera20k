<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The lobby and LAN discovery are HTTPS/UDP; ACCESS_WIFI_STATE is for the
         WifiManager locks multicast discovery needs (P8). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Vulkan is the shipping renderer baseline, so a device without it cannot
         run the game. GLES-only devices are not supported yet (P4 decision). -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="0"
        android:required="true" />
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="false" />

    <application
        android:label="VeraZip"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasCode="true"
        android:largeHeap="true"
        android:extractNativeLibs="false"
        android:allowBackup="false"
        android:theme="@style/Theme.VeraZip">

        <!-- The entry point: a resource inspector for the imported game files,
             with a button that starts the engine. It exists in this build
             because the engine's own shell cannot show a player what the import
             put on the phone; it also carries the "modified version" notice.
             Portrait is fine here, unlike the game surface. -->
        <activity
            android:name="org.vera20k.LauncherActivity"
            android:exported="true"
            android:label="VeraZip"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|fontScale|locale|layoutDirection">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The browser's own screens: readers for text and images, and the
             switches. None of them takes a content URI from another app, so
             they stay unexported. -->
        <activity
            android:name="org.vera20k.TextViewerActivity"
            android:exported="false"
            android:label="文本查看器"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|fontScale|locale|layoutDirection" />

        <activity
            android:name="org.vera20k.ImageViewerActivity"
            android:exported="false"
            android:label="图片查看器"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|fontScale|locale|layoutDirection" />

        <activity
            android:name="org.vera20k.TextEntryActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <activity
            android:name="org.vera20k.MixActivity"
            android:exported="false"
            android:label="MIX 归档"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|fontScale|locale|layoutDirection" />

        <activity
            android:name="org.vera20k.SettingsActivity"
            android:exported="false"
            android:label="设置"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|fontScale|locale|layoutDirection" />

        <activity
            android:name="org.vera20k.CampaignActivity"
            android:exported="false"
            android:label="战役"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|fontScale|locale|layoutDirection" />

        <activity
            android:name="org.vera20k.MapActivity"
            android:exported="false"
            android:label="地图"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|fontScale|locale|layoutDirection" />

        <!-- NativeActivity loads android.app.lib_name and calls android_main in
             libvera20k_android.so (android/src/lib.rs). configChanges lists
             everything winit handles, so a rotation or split-screen resize
             reaches Rust as a resize instead of destroying the activity. -->
        <activity
            android:name="org.vera20k.VeraActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection">

            <!-- The .so base name, without lib/ and .so: the crate's output is
                 libvera20k_android.so. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="vera20k_android" />

        </activity>
    </application>

</manifest>
